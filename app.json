{
  "expo": {
    "name": "On the Line",
    "slug": "on-the-line",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ontheline",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.falconlabs.ontheline",
      "associatedDomains": [
        "applinks:onthelineapp.app",
        "webcredentials:onthelineapp.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.falconlabs.ontheline",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "onthelineapp.app",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow On the Line to take the proof photo you choose to submit.",
          "photosPermission": "Allow On the Line to select the proof photo you choose to submit.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "@sentry/react-native",
      "expo-audio",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "falconlabs17s-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a6351a3-bd36-4417-84a2-3a5edf52dbfc"
      }
    }
  }
}
