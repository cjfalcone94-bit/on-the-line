{
  "expo": {
    "name": "On the Line",
    "slug": "on-the-line",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ontheline",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.ontheline.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ontheline.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow On the Line to take the proof photo you choose to submit.",
          "photosPermission": "Allow On the Line to select the proof photo you choose to submit.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
