{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "credentials/asc_api_key.p8",
        "ascApiKeyId": "54KAX6R47Z",
        "ascApiKeyIssuerId": "bcbb042b-ee08-4b76-8ac9-53aa961ec8cf",
        "ascAppId": "6796352788"
      }
    }
  }
}