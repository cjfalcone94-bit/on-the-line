{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "supabase/functions/**/index.ts",
    "supabase/functions/_shared/settlement-handler.ts",
    "supabase/functions/_shared/stripe-settlement.ts",
    "supabase/functions/_shared/change-disbursement.ts"
  ]
}
